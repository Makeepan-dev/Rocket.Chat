{
	"name": "@rocket.chat/media-calls",
	"version": "0.2.5",
	"private": true,
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
		"build-preview": "node -e \"require('fs').mkdirSync('../../.preview', { recursive: true })\" && node -e \"require('fs').cpSync('./dist', '../../.preview/media-calls', { recursive: true })\"",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@rocket.chat/core-typings": "workspace:^",
		"@rocket.chat/emitter": "^0.32.0",
		"@rocket.chat/logger": "workspace:^",
		"@rocket.chat/media-signaling": "workspace:^",
		"@rocket.chat/models": "workspace:^",
		"drachtio-srf": "patch:drachtio-srf@npm%3A5.0.12#~/.yarn/patches/drachtio-srf-npm-5.0.12-b0b1afaad6.patch"
	},
	"devDependencies": {
		"@rocket.chat/tsconfig": "workspace:*",
		"@types/jest": "~30.0.0",
		"eslint": "~9.39.3",
		"typescript": "~5.9.3"
	}
}
